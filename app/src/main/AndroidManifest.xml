<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Declared now; exercised by the player and the real content providers.
         Phases 1-5 run entirely on bundled mock data and never touch the network. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Mandatory for a television app: the device has no touchscreen. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- Amazon's guidance is not to require leanback; it also keeps the APK
         sideloadable onto a handset for inspection. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <application
        android:name=".MangoApplication"
        android:allowBackup="true"
        android:banner="@drawable/tv_banner"
        android:fullBackupContent="@xml/backup_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="false"
        android:theme="@style/Theme.MangoTV">

        <activity
            android:name=".navigation.MainActivity"
            android:banner="@drawable/tv_banner"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|smallestScreenSize|screenLayout|uiMode"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.MangoTV">

            <!-- Fire OS has historically launched apps through the standard
                 LAUNCHER category, while Android TV uses LEANBACK_LAUNCHER.
                 Declaring both costs nothing and covers every target. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
