<?xml version="1.0" encoding="utf-8"?>
<!--
  An episode.

  Unlike a poster card this one carries text, so it opts into being rasterised
  while it scales - otherwise every frame of the focus animation would
  re-render the glyphs.
-->
<tv.mango.app.ui.core.TvCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card"
    android:layout_width="@dimen/card_episode_width"
    android:layout_height="wrap_content"
    android:background="@drawable/card_placeholder">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/episode_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="@dimen/card_episode_height"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/episode_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_1"
            android:layout_marginTop="@dimen/space_1"
            android:layout_marginEnd="@dimen/space_1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Mango.CardTitle" />

        <TextView
            android:id="@+id/episode_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_1"
            android:layout_marginTop="@dimen/space_quarter"
            android:layout_marginEnd="@dimen/space_1"
            android:layout_marginBottom="@dimen/space_1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Mango.CardMeta" />

    </LinearLayout>

</tv.mango.app.ui.core.TvCardView>
