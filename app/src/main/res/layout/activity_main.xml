<?xml version="1.0" encoding="utf-8"?>
<!--
  The application shell: content, with the navigation rail drawn over its
  leading edge.

  Neither container paints a background. The window background already fills the
  screen with the base surface, and painting it again here would overdraw every
  pixel a second time on every frame.

  Content is inset by the rail's resting (collapsed) width, so the rail's own
  bounds never sit on top of a poster or a button underneath it. That reserved
  strip is a thin column of icons, not a blank bar - it is what the rail looks
  like at rest. The rail only grows past it, over the content, while it holds
  focus: NavRail changes its own width on that one event rather than the
  content ever moving, so opening it still costs nothing on every frame of the
  animation.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/nav_rail_collapsed"
        android:clipChildren="false" />

    <tv.mango.app.navigation.NavRail
        android:id="@+id/nav_rail"
        android:layout_width="@dimen/nav_rail_collapsed"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

</FrameLayout>
