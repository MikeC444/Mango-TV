<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings. Add-ons today; its own fragment rather than jumping straight to
  it so later settings have somewhere to live without it having to move.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/safe_area_horizontal"
    android:paddingTop="@dimen/safe_area_vertical"
    android:paddingEnd="@dimen/safe_area_horizontal"
    android:paddingBottom="@dimen/safe_area_vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textAppearance="@style/TextAppearance.Mango.Title" />

        <LinearLayout
            android:id="@+id/settings_addons_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_5"
            android:minWidth="@dimen/settings_row_min_width"
            android:background="@drawable/surface_focus_background"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:orientation="vertical"
            android:padding="@dimen/space_3">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_addons_title"
                android:textAppearance="@style/TextAppearance.Mango.Headline" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_quarter"
                android:text="@string/settings_addons_subtitle"
                android:textAppearance="@style/TextAppearance.Mango.Body" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
