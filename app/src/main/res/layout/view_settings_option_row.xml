<?xml version="1.0" encoding="utf-8"?>
<!-- Contents of one Home Screen settings row - a label and its current value,
     merged into SettingsOptionRow so the row costs one view group. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout">

    <TextView
        android:id="@+id/settings_row_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.Mango.Headline" />

    <TextView
        android:id="@+id/settings_row_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_3"
        android:gravity="end"
        android:textAppearance="@style/TextAppearance.Mango.Body" />

</merge>
