<?xml version="1.0" encoding="utf-8"?>
<!-- One installed add-on. Opens its detail screen; enabling, reordering and
     removing all live there rather than here, so this row stays one focusable
     target the same way every other list row in the app does. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_2"
    android:background="@drawable/surface_focus_background"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:gravity="center_vertical"
    android:minWidth="@dimen/settings_row_min_width"
    android:orientation="horizontal"
    android:padding="@dimen/space_3">

    <ImageView
        android:id="@+id/addon_logo"
        android:layout_width="@dimen/addon_logo_size"
        android:layout_height="@dimen/addon_logo_size"
        android:background="@drawable/cast_plate"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_2"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/addon_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Mango.Headline" />

        <TextView
            android:id="@+id/addon_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_quarter"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Mango.CardMeta" />

    </LinearLayout>

</LinearLayout>
