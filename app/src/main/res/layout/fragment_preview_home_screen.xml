<?xml version="1.0" encoding="utf-8"?>
<!--
  A live, navigable preview of Home under the current configuration, with a
  way to back out of anything changed since this screen opened. The preview
  itself is the real tv.mango.app.ui.home.HomeFragment, hosted as a child
  fragment - every row, the hero, focus and scrolling all behave exactly as
  they do on the real Home screen, because it is the real Home screen.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/preview_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/safe_area_horizontal"
        android:paddingTop="@dimen/space_2"
        android:paddingEnd="@dimen/safe_area_horizontal"
        android:paddingBottom="@dimen/space_2">

        <TextView
            android:id="@+id/preview_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/preview_title"
            android:textAppearance="@style/TextAppearance.Mango.Headline" />

        <tv.mango.app.ui.core.MangoButton
            android:id="@+id/preview_cancel"
            style="@style/Widget.Mango.Button"
            android:text="@string/action_cancel" />

        <tv.mango.app.ui.core.MangoButton
            android:id="@+id/preview_apply"
            style="@style/Widget.Mango.Button"
            android:layout_marginStart="@dimen/space_2"
            android:text="@string/action_apply" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/preview_home_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
