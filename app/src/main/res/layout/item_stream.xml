<?xml version="1.0" encoding="utf-8"?>
<!-- One source. Ranked, not sorted by which add-on answered first - see
     StreamRanker. A source this application cannot play directly (a torrent,
     a hand-off elsewhere) is shown rather than hidden, so the viewer can see
     it exists, but is not focusable. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_2"
    android:background="@drawable/surface_focus_background"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:minWidth="@dimen/settings_row_min_width"
    android:orientation="vertical"
    android:padding="@dimen/space_3">

    <TextView
        android:id="@+id/stream_quality"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Mango.Headline" />

    <TextView
        android:id="@+id/stream_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_quarter"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Mango.CardMeta" />

    <TextView
        android:id="@+id/stream_unsupported"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_quarter"
        android:text="@string/stream_picker_not_supported"
        android:textAppearance="@style/TextAppearance.Mango.Label"
        android:textColor="@color/accent"
        android:visibility="gone" />

</LinearLayout>
