<?xml version="1.0" encoding="utf-8"?>
<!-- A titled row: its heading, and the cards beneath it. -->
<tv.mango.app.ui.core.RowContainerView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="@dimen/row_spacing">

    <TextView
        android:id="@+id/row_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/row_header_spacing"
        android:paddingStart="@dimen/safe_area_horizontal"
        android:paddingEnd="@dimen/safe_area_horizontal"
        android:textAppearance="@style/TextAppearance.Mango.Headline" />

    <tv.mango.app.ui.core.RowRecyclerView
        android:id="@+id/row_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</tv.mango.app.ui.core.RowContainerView>
