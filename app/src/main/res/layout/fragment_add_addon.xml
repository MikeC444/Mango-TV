<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingStart="@dimen/safe_area_horizontal"
    android:paddingTop="@dimen/safe_area_vertical"
    android:paddingEnd="@dimen/safe_area_horizontal"
    android:paddingBottom="@dimen/safe_area_vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_addon_title"
            android:textAppearance="@style/TextAppearance.Mango.Title" />

        <LinearLayout
            android:id="@+id/add_addon_pairing"
            android:layout_width="@dimen/settings_content_max_width"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/add_addon_qr"
                android:layout_width="@dimen/qr_code_size"
                android:layout_height="@dimen/qr_code_size"
                android:background="@color/text_primary"
                android:contentDescription="@string/cd_add_addon_qr" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/space_2"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/add_addon_pairing_title"
                    android:textAppearance="@style/TextAppearance.Mango.Headline" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:text="@string/add_addon_pairing_body"
                    android:textAppearance="@style/TextAppearance.Mango.Body" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/add_addon_manual_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:text="@string/add_addon_manual_label"
            android:textAppearance="@style/TextAppearance.Mango.Overline" />

        <EditText
            android:id="@+id/add_addon_url"
            android:layout_width="@dimen/settings_content_max_width"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:background="@drawable/button_background"
            android:hint="@string/add_addon_url_hint"
            android:imeOptions="actionDone"
            android:inputType="textUri"
            android:maxLines="1"
            android:padding="@dimen/space_2"
            android:textAppearance="@style/TextAppearance.Mango.Body"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:orientation="horizontal">

            <Button
                android:id="@+id/add_addon_primary"
                style="@style/Widget.Mango.Button"
                android:text="@string/action_preview" />

            <Button
                android:id="@+id/add_addon_cancel"
                style="@style/Widget.Mango.Button"
                android:layout_marginStart="@dimen/space_2"
                android:text="@string/action_cancel" />

        </LinearLayout>

        <TextView
            android:id="@+id/add_addon_error"
            android:layout_width="@dimen/settings_content_max_width"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:textAppearance="@style/TextAppearance.Mango.Body"
            android:textColor="@color/accent"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/add_addon_preview"
            android:layout_width="@dimen/settings_content_max_width"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/add_addon_logo"
                android:layout_width="@dimen/addon_logo_size"
                android:layout_height="@dimen/addon_logo_size"
                android:background="@drawable/cast_plate"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/add_addon_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Mango.Headline" />

                <TextView
                    android:id="@+id/add_addon_version"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_quarter"
                    android:textAppearance="@style/TextAppearance.Mango.CardMeta" />

                <TextView
                    android:id="@+id/add_addon_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:textAppearance="@style/TextAppearance.Mango.Body" />

                <TextView
                    android:id="@+id/add_addon_types"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:textAppearance="@style/TextAppearance.Mango.Label" />

                <TextView
                    android:id="@+id/add_addon_resources"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_quarter"
                    android:textAppearance="@style/TextAppearance.Mango.Label" />

                <TextView
                    android:id="@+id/add_addon_already_installed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:text="@string/add_addon_already_installed"
                    android:textAppearance="@style/TextAppearance.Mango.Label"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/add_addon_configuration"
            android:layout_width="@dimen/settings_content_max_width"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_addon_needs_configuration_title"
                android:textAppearance="@style/TextAppearance.Mango.Headline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:text="@string/add_addon_needs_configuration_body"
                android:textAppearance="@style/TextAppearance.Mango.Body" />

            <TextView
                android:id="@+id/add_addon_configure_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:textAppearance="@style/TextAppearance.Mango.Label"
                android:textIsSelectable="true" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
