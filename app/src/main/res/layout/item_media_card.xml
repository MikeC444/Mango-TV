<?xml version="1.0" encoding="utf-8"?>
<!--
  One card: the focusable surface, the artwork on it, and a resume indicator.

  Spacing between cards belongs to the list, not to the card, so this one
  layout serves both a row and a grid.

  There is deliberately no title beneath the artwork. Rows of labelled cards
  read as a database; the focused title is named once, in the hero, where there
  is room to say something about it. Keeping text off the card also means the
  focus scale never has to re-rasterise glyphs.
-->
<tv.mango.app.ui.core.TvCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card"
    android:layout_width="@dimen/card_poster_width"
    android:layout_height="@dimen/card_poster_height"
    android:background="@drawable/card_placeholder">

    <ImageView
        android:id="@+id/artwork"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="@dimen/progress_bar_height"
        android:layout_gravity="bottom"
        android:background="@drawable/card_progress"
        android:visibility="gone" />

</tv.mango.app.ui.core.TvCardView>
