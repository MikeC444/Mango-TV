<?xml version="1.0" encoding="utf-8"?>
<!--
  One card: the focusable surface, the artwork on it, a resume indicator, and
  two pieces of optional overlay - a caption and a watched badge - that only
  ever inflate visible when a viewer's Poster & Card Layout settings ask for
  them (see Settings -> Home Screen -> Poster & Card Layout and each row's own
  Information toggles). At rest they cost one GONE view each, which the
  platform skips almost entirely during layout and draw.

  Spacing between cards belongs to the list, not to the card, so this one
  layout serves both a row and a grid.
-->
<tv.mango.app.ui.core.TvCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card"
    android:layout_width="@dimen/card_poster_width"
    android:layout_height="@dimen/card_poster_height"
    android:background="@drawable/card_placeholder">

    <ImageView
        android:id="@+id/artwork"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="@dimen/progress_bar_height"
        android:layout_gravity="bottom"
        android:background="@drawable/card_progress"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/scrim_bottom_band"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_1"
        android:paddingEnd="@dimen/space_1"
        android:paddingTop="@dimen/space_4"
        android:paddingBottom="@dimen/space_1"
        android:visibility="gone">

        <TextView
            android:id="@+id/caption_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Mango.CardTitle" />

        <TextView
            android:id="@+id/caption_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Mango.CardMeta" />

    </LinearLayout>

    <TextView
        android:id="@+id/watched_badge"
        android:layout_width="@dimen/watched_badge_size"
        android:layout_height="@dimen/watched_badge_size"
        android:layout_gravity="top|end"
        android:layout_margin="@dimen/space_half"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/label_watched_mark"
        android:textColor="@color/text_on_accent"
        android:textSize="12sp"
        android:visibility="gone" />

</tv.mango.app.ui.core.TvCardView>
