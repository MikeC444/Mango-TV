<?xml version="1.0" encoding="utf-8"?>
<!--
  The smaller liquid-glass surface: a settings row, an add-on card, a search
  field's resting shell. Same three-layer construction as glass_panel, at the
  tighter corner radius rows and controls use rather than the large panels.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_fill" />
            <corners android:radius="@dimen/panel_corner" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="@color/glass_sheen"
                android:centerColor="@color/transparent"
                android:endColor="@color/transparent"
                android:type="linear" />
            <corners android:radius="@dimen/panel_corner" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="@dimen/glass_stroke_width"
                android:color="@color/glass_stroke" />
            <corners android:radius="@dimen/panel_corner" />
        </shape>
    </item>

</layer-list>
