<?xml version="1.0" encoding="utf-8"?>
<!--
  Settles the bottom edge of large artwork into the page so it does not end on
  a hard line.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:endColor="@color/scrim_none"
        android:startColor="@color/surface_base"
        android:type="linear" />
</shape>
