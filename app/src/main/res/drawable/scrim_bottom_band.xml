<?xml version="1.0" encoding="utf-8"?>
<!--
  Settles the bottom edge of large artwork into the page so it does not end on
  a hard line.

  Unlike scrim_bottom, this one is meant for a view sized to a fixed band at
  the very bottom of the artwork rather than the artwork's full height, so a
  plain two-stop ramp across that band's own bounds is the right shape - it
  starts transparent at the band's own top edge and only has that one edge to
  agree with.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:endColor="@color/scrim_none"
        android:startColor="@color/surface_base"
        android:type="linear" />
</shape>
