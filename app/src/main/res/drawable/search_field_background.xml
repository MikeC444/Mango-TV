<?xml version="1.0" encoding="utf-8"?>
<!-- The search field's resting shell: a glass pill, brightened while it holds
     focus so a viewer typing can see where the remote's attention is even
     though an EditText has no separate "focused" fill state to speak of. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/glass_fill_focused" />
                    <corners android:radius="@dimen/search_field_corner" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <stroke
                        android:width="@dimen/glass_stroke_width"
                        android:color="@color/glass_stroke_focused" />
                    <corners android:radius="@dimen/search_field_corner" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/glass_fill" />
                    <corners android:radius="@dimen/search_field_corner" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <stroke
                        android:width="@dimen/glass_stroke_width"
                        android:color="@color/glass_stroke" />
                    <corners android:radius="@dimen/search_field_corner" />
                </shape>
            </item>
        </layer-list>
    </item>

</selector>
