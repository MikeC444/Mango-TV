<?xml version="1.0" encoding="utf-8"?>
<!--
  Keeps hero text legible over any artwork. A left-to-right ramp rather than a
  full-frame darkening, so the image stays bright where nothing sits on top of
  it.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="0"
        android:centerColor="@color/scrim_medium"
        android:centerX="0.45"
        android:endColor="@color/scrim_none"
        android:startColor="@color/scrim_strong"
        android:type="linear" />
</shape>
