<?xml version="1.0" encoding="utf-8"?>
<!--
  The focus treatment for rows that are not artwork.

  A poster lifts and brightens because it is an object being chosen between. A
  rail destination, a cast member, a settings row or an add-on card is a line
  in a list, and giving it the same physicality would flatten the difference.
  Instead it rests as a quiet glass card at all times - the "glass card" look
  the add-ons and settings screens are meant to have even before anything is
  focused - and focus brightens that same glass and picks up an accent edge,
  rather than swapping in an unrelated flat colour.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/glass_fill_focused" />
                    <corners android:radius="@dimen/panel_corner" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <stroke
                        android:width="@dimen/glass_stroke_width"
                        android:color="@color/glass_stroke_focused" />
                    <corners android:radius="@dimen/panel_corner" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:drawable="@drawable/glass_card" />
</selector>
