<?xml version="1.0" encoding="utf-8"?>
<!-- A recent-search chip: the same glass-to-accent focus language as every
     other control, at a pill radius instead of a card's. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent" />
            <corners android:radius="@dimen/chip_corner" />
        </shape>
    </item>

    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/glass_fill" />
                    <corners android:radius="@dimen/chip_corner" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <stroke
                        android:width="@dimen/glass_stroke_width"
                        android:color="@color/glass_stroke" />
                    <corners android:radius="@dimen/chip_corner" />
                </shape>
            </item>
        </layer-list>
    </item>

</selector>
