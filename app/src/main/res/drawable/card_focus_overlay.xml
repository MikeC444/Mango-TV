<?xml version="1.0" encoding="utf-8"?>
<!--
  The focused card treatment, as a single drawable whose alpha is animated.

  Three cues layered together, neither of them colour alone: the surface
  brightens as though it has moved closer to the light, a soft wide accent
  wash simulates a glow around the edge (a real blur is not worth the cost
  here, and clipToOutline would erase anything drawn outside the bounds
  anyway), and a crisp accent line on top of it confirms the selection
  precisely. All three are inset by 1dp so the card's rounded outline clip
  cannot shave any of them.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#33FFFFFF" />
            <corners android:radius="@dimen/card_corner" />
        </shape>
    </item>

    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="6dp"
                android:color="@color/accent_dim" />
            <corners android:radius="@dimen/card_corner" />
        </shape>
    </item>

    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="@dimen/focus_ring_width"
                android:color="@color/accent" />
            <corners android:radius="@dimen/card_corner" />
        </shape>
    </item>

</layer-list>
