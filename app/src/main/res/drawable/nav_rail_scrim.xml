<?xml version="1.0" encoding="utf-8"?>
<!--
  Fades in behind the navigation rail while it holds focus, so labels read
  against whatever is on screen without the content having to move aside.

  Translucent throughout rather than solid at the icon column: the rail is a
  glass panel drawn over the content, not an opaque wall in front of it, so
  whatever artwork is underneath keeps bleeding through even while the rail
  is open.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="0"
        android:centerColor="@color/glass_fill_focused"
        android:centerX="0.55"
        android:endColor="@color/scrim_none"
        android:startColor="@color/glass_fill_focused"
        android:type="linear" />
</shape>
