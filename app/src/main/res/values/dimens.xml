<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      8dp base grid. Every layout dimension lives here so the spacing system
      can be retuned in one place rather than hunted through layouts.
      Reference viewport is 960x540dp (1920x1080 at xhdpi).
    -->

    <dimen name="space_quarter">2dp</dimen>
    <dimen name="space_half">4dp</dimen>
    <dimen name="space_1">8dp</dimen>
    <dimen name="space_2">16dp</dimen>
    <dimen name="space_3">24dp</dimen>
    <dimen name="space_4">32dp</dimen>
    <dimen name="space_5">40dp</dimen>
    <dimen name="space_6">48dp</dimen>
    <dimen name="space_8">64dp</dimen>
    <dimen name="space_10">80dp</dimen>

    <!-- Television overscan safe area: 5% of the reference viewport. Nothing
         meaningful is drawn outside this inset. -->
    <dimen name="safe_area_horizontal">48dp</dimen>
    <dimen name="safe_area_vertical">27dp</dimen>

    <!-- Brand mark at the top of the navigation rail, present on every
         screen rather than only the home hero. -->
    <dimen name="nav_logo_size">56dp</dimen>

    <!-- The floating info panel a focused card shows below itself. Fixed
         rather than measured off the card, so its width does not visibly
         hop between a short and a long title. -->
    <dimen name="card_tooltip_width">240dp</dimen>
    <dimen name="card_tooltip_gap">10dp</dimen>

    <!-- Navigation rail. Collapsed it is a quiet strip of icons in its own
         reserved column, so the rail's bounds never overlap the content next
         to it - both so nothing underneath is covered and so the platform's
         own focus search recognises it as reachable by moving left. It only
         grows to its expanded width, drawing over the content, while it holds
         focus. -->
    <dimen name="nav_rail_collapsed">76dp</dimen>
    <dimen name="nav_rail_expanded">232dp</dimen>
    <dimen name="nav_item_height">44dp</dimen>
    <dimen name="nav_icon_size">20dp</dimen>
    <!-- Half the item's own height, so the resting and focused pill both
         read as a capsule rather than a rounded rectangle. -->
    <dimen name="nav_item_corner">22dp</dimen>

    <!-- Card geometry. Sizes are fixed so images can be decoded at exactly the
         pixels required and never larger. Small enough that a row reads as a
         shelf of titles rather than three enormous posters. -->
    <dimen name="card_poster_width">130dp</dimen>
    <dimen name="card_poster_height">195dp</dimen>
    <dimen name="card_landscape_width">260dp</dimen>
    <dimen name="card_landscape_height">146dp</dimen>
    <dimen name="card_continue_width">300dp</dimen>
    <dimen name="card_continue_height">169dp</dimen>
    <dimen name="card_episode_width">224dp</dimen>
    <dimen name="card_episode_height">126dp</dimen>
    <dimen name="card_gap">12dp</dimen>
    <dimen name="card_corner">10dp</dimen>

    <!-- Focus. A card lifts 10dp toward the viewer; only the focused card ever
         casts a shadow. -->
    <dimen name="focus_elevation">10dp</dimen>
    <dimen name="focus_ring_width">3dp</dimen>

    <!-- Content rows. -->
    <dimen name="row_header_spacing">12dp</dimen>
    <dimen name="row_spacing">32dp</dimen>

    <!-- Hero. Substantial without swallowing the first content row. -->
    <dimen name="hero_height">440dp</dimen>
    <dimen name="hero_text_max_width">560dp</dimen>
    <!-- The hero fades out over this much scroll, not over its own height -
         otherwise a taller hero would stay visible, faintly, behind rows for
         longer than a viewer scrolling past it would expect. -->
    <dimen name="hero_fade_distance">180dp</dimen>

    <!-- Buttons sized for confident D-pad targets at a distance. -->
    <dimen name="button_height">52dp</dimen>
    <dimen name="button_min_width">170dp</dimen>
    <dimen name="button_padding_horizontal">28dp</dimen>
    <dimen name="button_corner">14dp</dimen>

    <dimen name="progress_bar_height">3dp</dimen>
    <dimen name="hairline_width">1dp</dimen>

    <!-- Liquid glass panels. Large sits behind the hero and the detail info
         card; the smaller one is every other glass surface - rows, chips,
         settings and add-on cards. -->
    <dimen name="panel_corner_large">28dp</dimen>
    <dimen name="panel_corner">18dp</dimen>
    <dimen name="glass_stroke_width">1dp</dimen>

    <!-- Detail screen. -->
    <dimen name="detail_poster_width">200dp</dimen>
    <dimen name="detail_poster_height">300dp</dimen>
    <!-- Leaves the primary action on screen without scrolling at 540dp. -->
    <dimen name="detail_backdrop_height">400dp</dimen>
    <dimen name="cast_avatar_size">88dp</dimen>
    <dimen name="cast_item_width">104dp</dimen>
    <dimen name="detail_text_max_width">620dp</dimen>
    <dimen name="season_tab_min_width">120dp</dimen>

    <!-- Settings and add-ons. -->
    <dimen name="addon_logo_size">56dp</dimen>
    <dimen name="settings_row_min_width">420dp</dimen>
    <dimen name="settings_content_max_width">760dp</dimen>
    <dimen name="qr_code_size">176dp</dimen>

    <!-- Search. A search field is a button the size of a sentence: tall and
         obvious rather than a dense text box. -->
    <dimen name="search_field_height">64dp</dimen>
    <dimen name="search_field_corner">32dp</dimen>
    <dimen name="search_field_max_width">640dp</dimen>
    <dimen name="chip_height">40dp</dimen>
    <dimen name="chip_corner">20dp</dimen>

</resources>
