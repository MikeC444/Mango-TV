<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MangoTV" parent="Theme.AppCompat.NoActionBar">
        <!-- The window background is the only place the base surface is
             painted. Fragments and layouts stay transparent so the compositor
             never fills the same pixels twice. -->
        <item name="android:windowBackground">@color/surface_base</item>
        <item name="android:colorBackground">@color/surface_base</item>

        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>

        <!-- Cross-screen transitions are handled explicitly by the navigator so
             their timing matches the motion spec. -->
        <item name="android:windowAnimationStyle">@null</item>

        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorAccent">@color/accent</item>

        <item name="android:statusBarColor">@color/surface_base</item>
        <item name="android:navigationBarColor">@color/surface_base</item>
    </style>

    <!--
      The long-press quick-action menu. Full-screen rather than a floating
      dialog box: the window itself paints the dim scrim so CardActionSheet's
      own layout controls exactly where the panel sits, the same as every
      other glass surface in the app, rather than the platform's own dialog
      chrome boxing it in.
    -->
    <style name="Theme.Mango.ActionSheet" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

</resources>
